        "description": "Fjerne en oppforing med informasjon og tilhorende metadata slik at det ikke lenger vises i Folkeregisteret at informasjonen har vaert registrert. Informasjonen har aldri vaert gyldig.",
        "operationId": "sendInnAnnullering",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnnullereRequest"
              },
              "examples": {
                "melding": {
                  "$ref": "#/components/examples/AnnullereEksempel"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/omsorgsansvar/overfoere": {
      "post": {
        "tags": [
          "Innsending"
        ],
        "summary": "Send melding om overforing",
        "description": "Ansvaret for et fosterbarn overfores fra en barnevernstjeneste til en annen.",
        "operationId": "sendInnOverfoering",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OverfoereRequest"
              },
              "examples": {
                "melding": {
                  "$ref": "#/components/examples/OverfoereEksempel"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger/start": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Hent startsekvens for klient",
        "description": "Returnerer startsekvens for autentisert klient. Klienten ser kun sine egne hendelser. Serien er stigende, men kan inneholde hull. Klienten ma ikke anta at verdiene er fortlopende. Bruk denne ved oppstart: 1) Kall dette endepunktet. 2) Les `sekvensnummer` i responsen. 3) Kall `GET /api/v1/tilbakemeldinger` med `fraSekvensnummer=<sekvensnummer>`. Ved videre polling bruker klienten `nesteSekvensnummer` fra forrige poll-respons, ikke `/start` pa nytt.",
        "operationId": "hentStartsekvensForTilbakemeldinger",
        "parameters": [
          {
            "name": "dato",
            "in": "query",
            "required": false,
            "description": "Valgfri dato for startpunkt. Nar satt returneres sekvens som peker pa klientens hendelser fra oppgitt dato.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-09-01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Startsekvens for klient.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingStart"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Poll tilbakemeldinger",
        "description": "Henter tilbakemeldinger for autentisert klient fra og med gitt sekvens. Returnerer kun klientens egne meldinger. Serien er stigende, men kan inneholde hull. Klienten ma derfor alltid bruke returnert `nesteSekvensnummer` og ikke beregne neste verdi selv. Polling-flyt: 1) Start med sekvens fra `GET /api/v1/tilbakemeldinger/start`. 2) Send `fraSekvensnummer` i dette kallet. 3) Bruk `nesteSekvensnummer` fra responsen i neste kall. 4) Gjenta med jevnt intervall.",
        "operationId": "hentTilbakemeldinger",
        "parameters": [
          {
            "name": "fraSekvensnummer",
            "in": "query",
            "required": false,
            "description": "Sekvensnummer a starte fra (inkludert). Bruk `sekvensnummer` fra `/tilbakemeldinger/start` ved oppstart, og senere `nesteSekvensnummer` fra forrige poll-respons. Serien er stigende, men kan inneholde hull.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "antall",
            "in": "query",
            "required": false,
            "description": "Maks antall hendelser som returneres.",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste med tilbakemeldinger for klient.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingSide"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger/meldinger/{avsendersMeldingsidentifikator}": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Hent tilbakemelding per klientmeldingsid",
        "description": "Oppslag pa klientens egen meldingsid, for gjenfinning og verifisering etter en retry. Returnerer siste kjente tilbakemelding for meldingen.\nMerk: Meldingen er forst soekbar her nar tilbakemeldingen er tilgjengelig fra Folkeregisteret; inntil da returneres 404 selv om meldingen er sendt inn. Bruk `GET /api/v1/tilbakemeldinger` som primaerkilde, og dette endepunktet som supplement.",
        "operationId": "hentTilbakemeldingVedAvsendersMeldingsidentifikator",
        "parameters": [
          {
            "name": "avsendersMeldingsidentifikator",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tilbakemelding funnet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingHendelse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
