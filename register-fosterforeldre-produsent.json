{
  "openapi": "3.0.3",
  "info": {
    "title": "Fosterforeldre Omsorgsansvar Innsending API",
    "version": "v1",
    "description": "Brukervennlig API for innsending av meldinger om endring av omsorgsansvar, med asynkron tilbakemelding via polling. Payloaden er domenetilpasset og skjuler intern XML/XSD-struktur. Innsending bruker `application/json`.\n\nForesporselstyper:\n- Endre: Registrere ny oppforing med informasjon og tilhorende metadata i Folkeregisteret. Dersom verdi finnes fra for, blir denne meldingen avvist.\n- Opphoere: Avslutte gyldighetsperioden for en oppforing i Folkeregisteret ved a sette opphorstidspunktet i de tilhorende metadataene.\n- Korrigere: Bytte ut informasjon eller metadata pa en eksisterende oppforing i Folkeregisteret. Hele oppforingen far nytt ajourholdstidspunkt tilsvarende tidspunktet for korrigeringen.\n- Annullere: Fjerne en oppforing med informasjon og tilhorende metadata slik at det ikke lenger vises i Folkeregisteret at informasjonen har vaert registrert. Informasjonen har aldri vaert gyldig.\n- Overfoere: Ansvaret for et fosterbarn overfores fra en barnevernstjeneste til en annen."
  },
  "servers": [
    {
      "url": "https://api.test.fiks.ks.no/folkeregister/produsent",
      "description": "Test"
    },
    {
      "url": "https://api.fiks.ks.no/folkeregister/produsent",
      "description": "Produksjon"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Innsending",
      "description": "Endepunkter for innsending av meldinger om omsorgsansvar"
    },
    {
      "name": "Tilbakemelding",
      "description": "Endepunkter for polling og oppslag av tilbakemeldinger"
    }
  ],
  "paths": {
    "/api/v1/omsorgsansvar/endre": {
      "post": {
        "tags": [
          "Innsending"
        ],
        "summary": "Send melding om endring",
        "description": "Registrere ny oppforing med informasjon og tilhorende metadata i Folkeregisteret. Dersom verdi finnes fra for, blir denne meldingen avvist. Folgende felter finnes i Skatteetatens meldingsformat, men eksponeres ikke i request-payloaden og settes internt ved videreformidling: `forespoerseltype=endre`, `innsender[].innsendertype=barnevernstjenesten`, `mottak.informasjonskanal=elektroniskMelding` og `mottak.mottakstidspunktFraOpprinneligKanal` settes til tidspunktet da Fiks-plattformen mottar requesten fra klienten.",
        "operationId": "sendInnEndring",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndreRequest"
              },
              "examples": {
                "melding": {
                  "$ref": "#/components/examples/OmsorgsansvarEksempel"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Melding mottatt for asynkron behandling.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InnsendingKvittering"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/omsorgsansvar/korrigere": {
      "post": {
        "tags": [
          "Innsending"
