        "operationId": "sendInnKorrigering",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KorrigereRequest"
              },
              "examples": {
                "melding": {
                  "$ref": "#/components/examples/KorrigereEksempel"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/omsorgsansvar/opphoere": {
      "post": {
        "tags": [
          "Innsending"
        ],
        "summary": "Send melding om opphor",
        "description": "Avslutte gyldighetsperioden for en oppforing i Folkeregisteret ved a sette opphorstidspunktet i de tilhorende metadataene.",
        "operationId": "sendInnOpphoer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpphoereRequest"
              },
              "examples": {
