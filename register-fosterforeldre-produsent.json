        "summary": "Send melding om korrigering",
        "description": "Bytte ut informasjon eller metadata pa en eksisterende oppforing i Folkeregisteret. Hele oppforingen far nytt ajourholdstidspunkt tilsvarende tidspunktet for korrigeringen. Folgende felter finnes i Skatteetatens meldingsformat, men eksponeres ikke i request-payloaden og settes internt ved videreformidling: `forespoerseltype=korrigere`, `innsender[].innsendertype=barnevernstjenesten`, `mottak.informasjonskanal=elektroniskMelding` og `mottak.mottakstidspunktFraOpprinneligKanal` settes til tidspunktet da Fiks-plattformen mottar requesten fra klienten.",
        "operationId": "sendInnKorrigering",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KorrigereRequest"
              },
              "examples": {
                "melding": {
                  "$ref": "#/components/examples/OmsorgsansvarEksempel"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/omsorgsansvar/opphoere": {
      "post": {
        "tags": [
          "Innsending"
