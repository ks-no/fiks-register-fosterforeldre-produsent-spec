                "$ref": "#/components/schemas/AnnullereRequest"
              },
              "examples": {
                "melding": {
                  "$ref": "#/components/examples/OmsorgsansvarEksempel"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/omsorgsansvar/overfoere": {
      "post": {
        "tags": [
          "Innsending"
