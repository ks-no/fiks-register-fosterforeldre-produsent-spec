        "responses": {
          "202": {
            "$ref": "#/components/responses/Accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger/start": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Hent startsekvens for klient",
        "description": "Returnerer startsekvens for autentisert klient. Sekvensen er klient-skopet, ikke global. Sekvensnummer gjenbrukes fra Skatt og kan derfor inneholde hull; klienten ma ikke anta at verdiene er fortlopende.\nBruk denne ved oppstart: 1) Kall dette endepunktet. 2) Les `sekvensnummer` i responsen. 3) Kall `GET /api/v1/tilbakemeldinger` med `fraSekvensnummer=<sekvensnummer>`.\nVed videre polling bruker klienten `nesteSekvensnummer` fra forrige poll-respons, ikke `/start` pa nytt.",
        "operationId": "hentStartsekvensForTilbakemeldinger",
        "parameters": [
          {
            "name": "dato",
            "in": "query",
            "required": false,
            "description": "Valgfri dato for startpunkt. Nar satt returneres sekvens som peker pa klientens hendelser fra oppgitt dato.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-09-01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Startsekvens for klient.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingStart"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Poll tilbakemeldinger",
        "description": "Henter tilbakemeldinger for autentisert klient fra og med gitt sekvens. Returnerer kun klientens egne meldinger. Sekvensnummer gjenbrukes fra Skatt og kan inneholde hull, sa klienten ma alltid bruke returnert `nesteSekvensnummer` og ikke beregne neste verdi selv.\nPolling-flyt: 1) Start med sekvens fra `GET /api/v1/tilbakemeldinger/start`. 2) Send `fraSekvensnummer` i dette kallet. 3) Bruk `nesteSekvensnummer` fra responsen i neste kall. 4) Gjenta med jevnt intervall.",
        "operationId": "hentTilbakemeldinger",
        "parameters": [
          {
            "name": "fraSekvensnummer",
            "in": "query",
            "required": false,
            "description": "Sekvensnummer a starte fra (inkludert). Bruk `sekvensnummer` fra `/tilbakemeldinger/start` ved oppstart, og senere `nesteSekvensnummer` fra forrige poll-respons. Sekvensnummer kan inneholde hull fordi sekvensen gjenbrukes fra Skatt.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "antall",
            "in": "query",
            "required": false,
            "description": "Maks antall hendelser som returneres.",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste med tilbakemeldinger for klient.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingSide"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger/meldinger/{avsendersMeldingsidentifikator}": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Hent tilbakemelding per klientmeldingsid",
        "description": "Oppslag pa klientens egen meldingsid. Nyttig ved ny innsending/idempotens og gjenfinning.",
        "operationId": "hentTilbakemeldingVedAvsendersMeldingsidentifikator",
        "parameters": [
          {
            "name": "avsendersMeldingsidentifikator",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 4000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tilbakemelding funnet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingHendelse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/tilbakemeldinger/saker/{saksnummer}": {
      "get": {
        "tags": [
          "Tilbakemelding"
        ],
        "summary": "Hent status for sak",
        "description": "Returnerer siste kjente status for en innsending.",
        "operationId": "hentTilbakemeldingVedSaksnummer",
        "parameters": [
          {
            "name": "saksnummer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sak funnet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SakStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "examples": {
      "OmsorgsansvarEksempel": {
        "summary": "Melding om endring av omsorgsansvar",
        "value": {
          "avsendersMeldingsidentifikator": "MSG-2026-ENDRE-0001",
          "avsendersSaksreferanse": "SAK-2026-ENDRE-0001",
          "kildesystem": "Visma Flyt Barnevern",
          "gyldighetsdato": "2026-09-01",
          "innsender": [
            {
              "navnPaaBarnevernstjenesten": "Oslo barnevernstjeneste",
              "barnevernstjeneste": "123456789"
            }
          ],
          "barn": {
            "foedselsEllerDNummer": "01010112345"
          },
          "forelder": {
            "foedselsEllerDNummer": "02020223456"
          },
          "barnevernstjeneste": {
            "ansvarligBarnevernstjeneste": "111222333"
          }
        }
      }
    },
    "responses": {
      "Accepted": {
        "description": "Melding mottatt for asynkron behandling.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InnsendingKvittering"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Ugyldig input.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Feilmelding"
            },
            "examples": {
              "ugyldigInput": {
                "summary": "Ugyldig payload eller valideringsfeil",
                "value": {
                  "kode": "valideringsfeil",
                  "backendFeilkode": "ske.folkeregister.mottak.infrastructure.exceptions.ValideringsFeil",
                  "melding": "Feltet 'barn.foedselsEllerDNummer' ma matche ^[0-9]{11}$",
                  "httpStatus": 400,
                  "alvorlighetsgrad": "WARNING",
                  "tilleggsinformasjon": "felt=barn.foedselsEllerDNummer, regel=^[0-9]{11}$",
                  "korrelasjonsid": "56a8ad5a81ec4cf4aa4f790507cd66a0"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Mangler gyldig autentisering."
      },
      "Forbidden": {
        "description": "Ikke tilgang."
      },
      "NotFound": {
        "description": "Ressurs ikke funnet.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Feilmelding"
            }
          }
        }
      }
    },
    "schemas": {
      "EndreRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "KorrigereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "OpphoereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "AnnullereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "OverfoereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "OmsorgsansvarEndringRequest": {
        "type": "object",
        "description": "Offentlig requestmodell. Folgende felter fra Skatteetatens backend-melding (XSD) eksponeres ikke i API-et, men settes internt ved videreformidling:\n- `forespoerseltype`: utledes av valgt endepunkt:\n  `/omsorgsansvar/endre` -> `endre`, `/omsorgsansvar/korrigere` -> `korrigere`, `/omsorgsansvar/opphoere` -> `opphoere`, `/omsorgsansvar/annullere` -> `annullere`, `/omsorgsansvar/overfoere` -> `overfoere`.\n- `innsender[].innsendertype`: settes til `barnevernstjenesten`.\n- `mottak.informasjonskanal`: settes til `elektroniskMelding`.\n- `mottak.mottakstidspunktFraOpprinneligKanal`: settes til tidspunktet da Fiks-plattformen mottar requesten fra klienten ved videreformidling til Skatt.",
        "required": [
          "avsendersMeldingsidentifikator",
          "avsendersSaksreferanse",
          "kildesystem",
          "gyldighetsdato",
          "innsender",
          "barn",
          "forelder",
          "barnevernstjeneste"
        ],
        "properties": {
          "avsendersMeldingsidentifikator": {
            "type": "string",
            "maxLength": 4000,
            "description": "Klientens unike meldingsid. Brukes som idempotensnokkel (unik per klient/tenant)."
          },
          "avsendersSaksreferanse": {
            "type": "string",
            "maxLength": 4000,
            "description": "Klientens interne saksreferanse. Obligatorisk og returneres i tilbakemeldinger."
          },
          "kildesystem": {
            "type": "string",
            "maxLength": 4000,
            "description": "Navn pa avgivende kildesystem."
          },
          "gyldighetsdato": {
            "type": "string",
            "format": "date",
            "description": "Operasjonsspesifikk dato: gyldig fra, opphor, eller overforingstidspunkt avhengig av endepunkt."
          },
          "innsender": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Innsender"
            },
            "description": "En eller flere innsendere."
          },
          "barn": {
            "$ref": "#/components/schemas/Personidentifikator"
          },
          "forelder": {
            "$ref": "#/components/schemas/Personidentifikator"
          },
          "barnevernstjeneste": {
            "$ref": "#/components/schemas/Barnevernstjeneste"
          }
        }
      },
      "Innsender": {
        "type": "object",
        "required": [
          "navnPaaBarnevernstjenesten",
          "barnevernstjeneste"
        ],
        "properties": {
          "navnPaaBarnevernstjenesten": {
            "type": "string",
            "maxLength": 175
          },
          "barnevernstjeneste": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          }
        }
      },
      "Personidentifikator": {
        "type": "object",
        "required": [
          "foedselsEllerDNummer"
        ],
        "properties": {
          "foedselsEllerDNummer": {
            "type": "string",
            "pattern": "^[0-9]{11}$",
            "description": "Fodselsnummer eller D-nummer (11 siffer)."
          }
        }
      },
      "Barnevernstjeneste": {
        "type": "object",
        "required": [
          "ansvarligBarnevernstjeneste"
        ],
        "properties": {
          "ansvarligBarnevernstjeneste": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          }
        }
      },
      "InnsendingKvittering": {
        "type": "object",
        "description": "Synkron kvittering fra Fiks-mottaket. Tilsvarer Folkeregisterets `<meldingMottatt>`-svar pa selve innsendingen: kun `folkeregisterReferanse` og `avsendersMeldingsidentifikator` er kjent pa dette tidspunktet. `saksnummer` og videre saksbehandlingsstatus blir forst kjent asynkront og ma hentes via polling eller direkte oppslag.",
        "required": [
          "folkeregisterReferanse",
          "avsendersMeldingsidentifikator",
          "status",
          "mottattTidspunkt"
        ],
        "properties": {
          "folkeregisterReferanse": {
            "type": "string",
            "description": "Tekst-referanse returnert fra Folkeregisterets mottak ved akseptert innsending."
          },
          "avsendersMeldingsidentifikator": {
            "type": "string"
          },
          "saksnummer": {
            "type": "string",
            "description": "Saksnummer hos Folkeregisteret. Ikke kjent pa innsendingstidspunktet og derfor ikke med i dette svaret; hentes senere via polling eller direkte oppslag."
          },
          "status": {
            "type": "string",
            "enum": [
              "MOTTATT"
            ],
