    "schemas": {
      "EndreRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "KorrigereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "OpphoereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "AnnullereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "OverfoereRequest": {
        "$ref": "#/components/schemas/OmsorgsansvarEndringRequest"
      },
      "OmsorgsansvarEndringRequest": {
        "type": "object",
        "description": "Requestmodell for innsending. Operasjonen bestemmes av endepunktet: `endre`, `korrigere`, `opphoere`, `annullere` eller `overfoere`.",
        "required": [
          "avsendersMeldingsidentifikator",
          "avsendersSaksreferanse",
          "kildesystem",
          "gyldighetsdato",
          "innsender",
          "fosterbarn",
          "fosterforelder",
          "barnevernstjeneste"
        ],
        "properties": {
          "avsendersMeldingsidentifikator": {
            "type": "string",
            "format": "uuid",
            "description": "Klientens unike meldingsid (UUID). Brukes som idempotensnokkel og ma vaere globalt unik."
          },
          "avsendersSaksreferanse": {
            "type": "string",
            "maxLength": 4000,
            "description": "Klientens interne saksreferanse. Obligatorisk. Verdien trenger ikke vaere unik pa tvers av klienter, og returneres uendret i tilbakemeldinger."
          },
          "kildesystem": {
            "type": "string",
            "maxLength": 4000,
            "description": "Navn pa avgivende kildesystem."
          },
          "gyldighetsdato": {
            "type": "string",
            "format": "date",
            "description": "Operasjonsspesifikk dato: gyldig fra, opphor, eller overforingstidspunkt avhengig av endepunkt."
          },
          "innsender": {
            "$ref": "#/components/schemas/Innsender"
          },
          "barnevernstjeneste": {
            "$ref": "#/components/schemas/Barnevernstjeneste"
          },
          "fosterbarn": {
            "$ref": "#/components/schemas/Personidentifikator"
          },
          "fosterforelder": {
            "$ref": "#/components/schemas/Personidentifikator"
          }
        }
      },
      "Innsender": {
        "type": "object",
        "description": "Barnevernstjenesten som sender inn meldingen.",
        "required": [
          "barnevernstjeneste"
        ],
        "properties": {
          "barnevernstjeneste": {
            "type": "string",
            "pattern": "^[0-9]{9}$",
            "description": "Organisasjonsnummer for barnevernstjenesten som sender meldingen."
          }
        }
      },
      "Personidentifikator": {
        "type": "object",
        "required": [
          "foedselsEllerDNummer"
        ],
        "properties": {
          "foedselsEllerDNummer": {
            "type": "string",
            "pattern": "^[0-9]{11}$",
            "description": "Fodselsnummer eller D-nummer (11 siffer)."
          }
        }
      },
      "Barnevernstjeneste": {
        "type": "object",
        "required": [
          "ansvarligBarnevernstjeneste"
        ],
        "properties": {
          "ansvarligBarnevernstjeneste": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          }
        }
      },
      "InnsendingKvittering": {
        "type": "object",
        "description": "Synkron kvittering fra Fiks pa selve innsendingen: kun `folkeregisterReferanse` og `avsendersMeldingsidentifikator` er kjent pa dette tidspunktet. `saksnummer` og videre saksbehandlingsstatus blir forst kjent asynkront og ma hentes via polling eller direkte oppslag.",
        "required": [
          "folkeregisterReferanse",
          "avsendersMeldingsidentifikator",
          "status",
          "mottattTidspunkt"
        ],
        "properties": {
          "folkeregisterReferanse": {
            "type": "string",
            "description": "Referanse fra Folkeregisteret ved akseptert innsending."
          },
          "avsendersMeldingsidentifikator": {
            "type": "string",
            "format": "uuid",
            "description": "Klientens meldingsid slik den ble sendt inn."
          },
          "saksnummer": {
            "type": "string",
            "description": "Saksnummer hos Folkeregisteret. Ikke kjent pa innsendingstidspunktet og derfor ikke med i dette svaret; hentes senere via polling eller direkte oppslag."
          },
          "status": {
            "type": "string",
            "enum": [
              "MOTTATT"
            ],
            "description": "Fiks' kvitteringsstatus ved mottak av meldingen, for Folkeregisteret har fattet en beslutning. Endelig utfall hentes via polling eller direkte oppslag."
          },
