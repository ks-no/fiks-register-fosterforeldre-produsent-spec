{
  "openapi": "3.0.3",
  "info": {
    "title": "KS FIKS: Register fosterforeldre produsent API",
    "description": "API for registrering av fosterforeldre.",
    "contact": {
      "name": "Fiks Register",
      "url": "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter",
      "email": "fiks-utvikling@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.ks.no",
      "description": "KS Fiks API host"
    },
    {
      "url": "https://api.test.fiks.ks.no",
      "description": "KS Fiks TEST API host"
    }
  ],
  "tags": [
    {
      "name": "Tilbakemelding",
      "description": "Endepunkter for tilbakemeldinger"
    },
    {
      "name": "Mottak",
      "description": "Endepunkter for mottak"
    }
  ],
  "paths": {
    "/register/api/v1/fosterforeldre/tilbakemelding": {
      "get": {
        "summary": "Hent tilbakemeldinger",
        "description": "Henter tilbakemeldinger fra Skatteetaten på innsendte saker. En tilbakemelding indikerer om saken ble akseptert, avvist, eller krever manuell behandling.",
        "operationId": "hentTilbakemeldinger",
        "tags": [
          "Tilbakemelding"
        ],
        "parameters": [
          {
            "name": "sekvensnummer",
            "in": "query",
            "description": "Sekvensnummer å hente tilbakemeldinger fra.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "antall",
            "in": "query",
            "description": "Antall tilbakemeldinger som returneres.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "En liste over tilbakemeldinger.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tilbakemelding"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/register/api/v1/fosterforeldre/mottak": {
      "post": {
        "summary": "Send inn mottak",
        "description": "Sender inn en sak til Skatteetaten for registrering. Dersom saken krever manuell behandling kan endepunktet kalles på nytt med oppdatert informasjon.",
        "operationId": "opprettMottak",
        "tags": [
          "Mottak"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "fosterBarnId",
                  "dato"
                ],
                "properties": {
                  "fosterBarnId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dato": {
                    "type": "string",
                    "format": "date",
                    "description": "Dato hendelsen inntraff.",
                    "example": "2026-06-01"
                  },
                  "referanseId": {
                    "type": "string",
                    "description": "Avsenders egen referanse, returneres uendret på tilbakemeldinger."
                  },
                  "merknad": {
                    "type": "string"
                  },
                  "periode": {
                    "$ref": "#/components/schemas/Periode"
                  },
                  "vedlegg": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "vedlegg": {
                  "contentType": "application/pdf, image/png, image/jpeg"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mottak registrert.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tilbakemelding"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang \u2013 bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/register/api/v1/fosterforeldre/tilbakemelding/start": {
      "get": {
        "summary": "Hent startsekvensnummer",
        "description": "Henter sekvensnummeret det skal polles tilbakemeldinger fra. Bruk dette som utgangspunkt før du starter polling mot tilbakemeldinger-endepunktet.",
        "operationId": "hentTilbakemeldingStart",
        "tags": [
          "Tilbakemelding"
        ],
        "parameters": [
          {
            "name": "dato",
            "in": "query",
            "required": false,
            "description": "Dato det skal hentes startsekvensnummer for.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-06-01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Starttilstand for hendelser.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilbakemeldingStart"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/register/api/v1/fosterforeldre/tilbakemelding/status/{sakId}": {
      "get": {
        "summary": "Hent status for sak",
        "description": "Henter status for en spesifisert sak.",
        "operationId": "hentTilbakemeldingStatus",
        "tags": [
          "Tilbakemelding"
        ],
        "parameters": [
          {
            "name": "sakId",
            "in": "path",
            "required": true,
            "description": "Unik identifikator for saken.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "123e4567-e89b-12d3-a456-426614174002"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status for saken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SakStatus"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Sak ikke funnet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tilbakemelding": {
        "type": "object",
        "properties": {
          "referanseId": {
            "type": "string",
            "description": "Avsenders egen referanse, sendt inn på mottak."
          },
          "tittel": {
            "type": "string",
            "example": "Hendelse i sak"
          },
          "sekvensnummer": {
            "type": "integer",
            "format": "int64",
            "example": 5
          },
          "oppdatert": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2016-12-21T09:01:34.496Z"
          },
          "hendelseinfo": {
            "$ref": "#/components/schemas/Hendelseinfo"
          }
        },
        "required": [
          "tittel",
          "sekvensnummer",
          "oppdatert",
          "hendelseinfo"
        ]
      },
      "Periode": {
        "type": "object",
        "properties": {
          "startTidspunkt": {
            "type": "string",
            "format": "date-time",
            "description": "Startidspunkt for perioden.",
            "example": "2026-01-01T00:00:00.000Z"
          },
          "sluttTidspunkt": {
            "type": "string",
            "format": "date-time",
            "description": "Sluttidspunkt for perioden.",
            "example": "2026-12-31T23:59:59.999Z"
          }
        }
      },
      "Hendelseinfo": {
        "type": "object",
        "properties": {
          "sak": {
            "$ref": "#/components/schemas/Sak"
          },
          "sakTilManuellBehandling": {
            "$ref": "#/components/schemas/SakTilManuellBehandling"
          }
        },
        "required": [
          "sak"
        ]
      },
      "Sak": {
        "type": "object",
        "properties": {
          "sakId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "example": "123e4567-e89b-12d3-a456-426614174002"
          },
          "saksnummer": {
            "type": "string",
            "example": "117152"
          },
          "opprettet": {
            "type": "string",
            "format": "date-time",
            "example": "2016-12-21T09:01:30.687Z"
          },
          "avsendersSaksreferanse": {
            "type": "string",
            "example": "201216/fil-7-wf"
          },
          "meldingsreferanse": {
            "$ref": "#/components/schemas/Meldingsreferanse"
          }
        },
        "required": [
          "sakId",
          "saksnummer",
          "opprettet"
        ]
      },
      "Meldingsreferanse": {
        "type": "object",
        "properties": {
          "avsendersMeldingsidentifikator": {
            "type": "string",
            "example": "2112116 - avviksmerknad om dublett og merknad om forkortet navn"
          },
          "folkeregisterReferanse": {
            "type": "string",
            "format": "uuid",
            "example": "ab567940-cfd6-4a0d-aec6-44999e5aa4b1"
          }
        }
      },
      "SakTilManuellBehandling": {
        "type": "object",
        "properties": {
          "saksfrist": {
            "type": "string",
            "format": "date",
            "example": "2016-12-26"
          },
          "begrunnelse": {
            "type": "string",
            "example": "muligDublett"
          }
        },
        "required": [
          "saksfrist",
          "begrunnelse"
        ]
      },
      "TilbakemeldingStart": {
        "type": "object",
        "properties": {
          "sekvensnummer": {
            "type": "integer",
            "format": "int64",
            "example": 0
          }
        },
        "required": [
          "sekvensnummer"
        ]
      },
      "SakStatus": {
        "type": "object",
        "properties": {
          "sakId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "example": "123e4567-e89b-12d3-a456-426614174002"
          },
          "status": {
            "type": "string",
            "enum": [
              "MOTTATT",
              "UNDER_BEHANDLING",
              "FERDIGBEHANDLET",
              "AVVIST",
              "TRENGER_MANUELL_BEHANDLING"
            ],
            "example": "UNDER_BEHANDLING"
          },
          "oppdatert": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "sakId",
          "status",
          "oppdatert"
        ]
      }
    }
  }
}
